# Circle Modular Wallets — https://console.circle.com/wallets/modular/configurator
# Console -> Keys -> Client Key (Web, bound to your passkey domain).
CIRCLE_CLIENT_KEY=TEST_CLIENT_KEY:...
# Base URL only. The chain suffix (/arcTestnet) is appended in code; passkey RP calls use the base.
CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Must match Configurator -> Passkey -> Domain Name. Circle validates the client key against
# this via X-AppInfo, and React Native has no window.location to supply it.
EXPO_PUBLIC_CIRCLE_PASSKEY_DOMAIN=your-passkey-domain.example
EXPO_PUBLIC_CIRCLE_CLIENT_KEY=TEST_CLIENT_KEY:...
EXPO_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# --- Arc's endpoint ---
# Both are optional: with neither set, everything uses Arc's public endpoint and works. They exist
# because that endpoint rate-limits and is shared by the screens, the payments feed, every live test
# and every fork — on 09-11 it refused eighteen reads in a single gate run.
#
# Off-device only — the tests, the forked chains they build, the connector and the scripts. Read by
# Node, never inlined into anything.
ARC_TESTNET_RPC_URL=https://your-own-endpoint.example
#
# Carried by the app. Expo inlines every EXPO_PUBLIC_ variable its code refers to, so whatever is
# here ships inside the build and can be read out of it: treat it as published, and rotate it rather
# than believing it secret. It is set so that somebody who installs the app and does nothing else
# gets a fast endpoint instead of a shared one. Leave it empty and the app uses Arc's public
# endpoint; anybody can also paste one of their own into Settings, which beats both.
EXPO_PUBLIC_ALCHEMY_ARC_TESTNET=https://your-own-endpoint.example

# --- The agent (mcp/) ---
# Arc has no public bundler, so an agent cannot submit a payment without one. These point it at
# Circle's, which sponsors the operation — so neither the agent nor the account pays gas, and
# nothing ever has to be transferred to an agent.
#
# This is the same client key the mobile app ships in its bundle. It is bound to the passkey
# domain and grants no authority by itself: a spend still needs a session-key signature that the
# mandate permits.
CIRCLE_PASSKEY_DOMAIN=your-passkey-domain.example
# CIRCLE_CLIENT_KEY and CIRCLE_CLIENT_URL are already set above and are reused by the agent.
