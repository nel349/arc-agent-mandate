{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    /* Unused imports and locals are dead code, and the review that catches them by eye
       is the review that eventually stops happening. */
    "noUnusedLocals": true,
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@passkey-native": [
        "./modules/arc-passkey/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "app/**/*.tsx",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
