{
  "name": "arc-agent-mandate",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "npm run setup:contracts --silent >/dev/null 2>&1 || true; node --experimental-transform-types --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts' 'mcp/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "test:contracts": "npm run setup:contracts --silent >/dev/null 2>&1 || true; cd contracts && ARC_TESTNET_RPC_URL=${ARC_TESTNET_RPC_URL:-https://rpc.testnet.arc.network} FOUNDRY_DISABLE_NIGHTLY_WARNING=1 forge test",
    "test:integration": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test integration/*.test.ts",
    "gate": "npm run typecheck && npm test && npm run test:contracts && npm run test:integration",
    "prepare": "npm run setup:contracts --silent >/dev/null 2>&1 || true",
    "setup:contracts": "git submodule update --init --recursive contracts/lib && npm --prefix contracts install --silent"
  },
  "dependencies": {
    "@circle-fin/modular-wallets-core": "^1.0.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "dotenv": "^17.4.2",
    "expo": "^54.0.0",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "qrcode-terminal": "^0.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "viem": "^2.45.3",
    "webauthn-p256": "^0.0.5",
    "zod": "^3.25.76"
  },
  "type": "module",
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
