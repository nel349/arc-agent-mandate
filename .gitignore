# Dependencies
node_modules/

# Secrets — .env.example documents the shape
.env
.env.local
.env.*.local

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects generated by `expo prebuild`. Leading slashes matter: without them these
# patterns would also exclude modules/arc-passkey/ios and .../android, which are OUR SOURCE.
/ios/
/android/

# Build output
*.jsbundle
*.tsbuildinfo

# Native build artifacts inside our own module (sources stay tracked)
modules/**/android/build/
modules/**/android/.gradle/
modules/**/ios/build/
modules/**/*.xcworkspace/xcuserdata/
modules/**/*.xcodeproj/xcuserdata/

# Tooling
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
coverage/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Foundry (contracts/)
contracts/out/
contracts/cache/
contracts/node_modules/
contracts/broadcast/
mcp-config.local.json
